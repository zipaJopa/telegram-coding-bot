# ========================================
# REQUIRED: Telegram Bot Configuration
# ========================================

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ========================================
# REQUIRED: Coding Agent Configuration
# ========================================

# OpenRouter API Key (FREE models available!)
# Get free key from: https://openrouter.ai/
# Uses: qwen/qwen-2.5-coder-32b-instruct:free (unlimited)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ========================================
# CLI Agent Authentication (OAuth)
# ========================================
# Gemini CLI and QwenCode CLI use OAuth authentication
# Run these commands to authenticate (credentials saved locally):
#
#   pnpm add -g @google/gemini-cli
#   gemini auth login
#
#   pnpm add -g qwen-code
#   qwencode auth login
#
# Credentials will be stored in:
#   - ~/.gemini/credentials.json (Gemini CLI)
#   - ~/.qwen/credentials.json (QwenCode CLI)
#
# See OAUTH_SETUP.md for complete instructions

# ========================================
# OPTIONAL: GitHub CLI (for git operations)
# ========================================
# Create a Personal Access Token at: https://github.com/settings/tokens
# Required scopes: repo, workflow
# GH_TOKEN=your_github_personal_access_token_here
